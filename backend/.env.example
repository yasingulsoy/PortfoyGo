# =============================================================================
# PortfoyGo backend — örnek ortam değişkenleri
# Bu dosyayı .env olarak kopyalayıp değerleri doldurun. .env dosyasını ASLA commit etmeyin.
# =============================================================================

# --- Sunucu ------------------------------------------------------------------
# Çalışma ortamı: development | production
NODE_ENV=
# API'nin dinleyeceği port (varsayılan 5001)
PORT=
# İzin verilen frontend origin'leri, virgülle ayrılmış (örn. https://portfoygo.com,http://localhost:3000)
ALLOWED_ORIGINS=
# Reverse proxy (nginx, Render, Railway vb.) arkasındaysa 1 yapın; rate limit gerçek IP'yi görsün
TRUST_PROXY=
# Genel API istek sınırı (IP başına dakikada; varsayılan 300). Yerel dev:local otomatik olarak 5000 kullanır.
API_RATE_LIMIT_PER_MIN=

# --- Kimlik doğrulama --------------------------------------------------------
# ZORUNLU. JWT imzalama anahtarı; en az 32 karakter, rastgele (örn. `openssl rand -hex 48`)
JWT_SECRET=
# Oturum çerezi (pg_session, httpOnly) için Secure bayrağı: 1 | true. NODE_ENV=production iken her zaman açıktır
COOKIE_SECURE=
# Çerez alan adı (isteğe bağlı). Frontend ve API farklı alt alan adlarındaysa ortak üst alan adı verin
# (örn. app.portfoygo.com + api.portfoygo.com için .portfoygo.com). Boş: sadece API host'u
COOKIE_DOMAIN=
# İki adımlı doğrulama (TOTP) gizli anahtarlarını AES-256-GCM ile şifreleyen 32 baytlık anahtar:
# 64 hex karakter (örn. `openssl rand -hex 32`) veya base64. PRODUCTION'DA ZORUNLU (yoksa 2FA kurulamaz ve 2FA'lı
# hesaplar girişi tamamlayamaz). Kalıcı saklayın: değişirse mevcut 2FA kayıtları çözülemez.
# Yerel geliştirmede boşsa JWT_SECRET'tan geliştirme anahtarı türetilir.
TOTP_ENC_KEY=
# Yönetim API'si yalnızca 2FA'sı açık yöneticilere açık mı: 1 | 0. Boş: production'da açık, diğer ortamlarda kapalı
ADMIN_REQUIRE_2FA=

# --- Veritabanı --------------------------------------------------------------
# Tam bağlantı adresi (verilirse DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD yok sayılır)
DATABASE_URL=
# DATABASE_URL yoksa kullanılan ayrı parametreler
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# SSL kullanımı: true | false (boş: DATABASE_URL içindeki sslmode geçerli olur)
DB_SSL=
# SSL sertifika doğrulaması (varsayılan true). Sadece zorunluysa false yapın
DB_SSL_REJECT_UNAUTHORIZED=
# İsteğe bağlı özel CA sertifikası (PEM; satır sonları \n olarak yazılabilir)
DB_SSL_CA=
# Havuzdaki en fazla bağlantı sayısı (varsayılan 10)
DB_POOL_MAX=
# Bağlantı kurma zaman aşımı, ms (varsayılan 10000)
DB_CONNECTION_TIMEOUT_MS=
# Boştaki bağlantının kapatılma süresi, ms (varsayılan 30000)
DB_IDLE_TIMEOUT_MS=

# --- Veri sağlayıcı seçimi (bkz. src/providers/README.md) -------------------
# Boş bırakılırsa varsayılanlar kullanılır: finnhub / coingecko / nosyapi / nosyapi / rss
STOCK_PROVIDER=
CRYPTO_PROVIDER=
FX_PROVIDER=
COMMODITY_PROVIDER=
NEWS_PROVIDER=

# --- Piyasa verisi API anahtarları ------------------------------------------
# Finnhub hisse verisi: tek anahtar
FINNHUB_API_KEY=
# Finnhub: birden çok anahtar, virgülle ayrılmış (verilirse FINNHUB_API_KEY yerine kullanılır)
FINNHUB_API_KEYS=
# Takip edilen hisseler, virgülle ayrılmış (boş: AAPL,MSFT,GOOGL,AMZN,TSLA,META,NVDA,NFLX,AMD,INTC)
STOCK_SYMBOLS=
# CoinGecko anahtarı (isteğe bağlı; boşsa ücretsiz uç kullanılır)
COINGECKO_API_KEY=
# Eski ad (geriye dönük uyumluluk); COINGECKO_API_KEY tercih edin
NEXT_PUBLIC_COINGECKO_API_KEY=
# NosyAPI döviz kurları anahtarı
DOVIZ=
# NosyAPI emtia fiyatları anahtarı
EMTIA=
# Veritabanında güncel USD kuru yoksa kullanılacak yedek USD/TRY (boş/0: işlemler reddedilir)
DEFAULT_USD_TRY=
# Herkese açık hisse listesi isteklerinin arka plan cache yenilemesini kapatmak için false
ENABLE_BACKGROUND_STOCK_REFRESH=

# --- Email (SMTP) ------------------------------------------------------------
# SMTP sunucusu (varsayılan smtp.gmail.com)
SMTP_HOST=
# SMTP portu (varsayılan 587)
SMTP_PORT=
# TLS ile bağlan: true | false (boş: port 465 ise true)
SMTP_SECURE=
# SMTP kullanıcı adı
SMTP_USER=
# SMTP şifresi / uygulama şifresi
SMTP_PASS=
# Gönderen adresi (boş: "PortfoyGo" <SMTP_USER>)
SMTP_FROM=

# --- Haftalık e-posta özeti (iş: weekly-digest, Pazartesi 09:00 İstanbul) ------
# Gönderim koruması: NODE_ENV=production iken gönderir (0 ile kapatılır). Diğer ortamlarda GERÇEK E-POSTA
# GİTMEZ (yalnızca log + backend/.localdb/digest-previews); geliştirmede göndermek için açıkça 1 verin.
EMAIL_DIGEST_SEND=
# Gönderimler arası bekleme, ms (SMTP sağlayıcısının hız sınırı için; varsayılan 200)
EMAIL_DIGEST_DELAY_MS=
# Abonelikten çıkma bağlantısının imza anahtarı (boş: JWT_SECRET'tan türetilir; JWT_SECRET değişince eski
# e-postalardaki bağlantılar geçersiz olur — kalıcı olması için ayrı, rastgele bir değer verin)
EMAIL_UNSUBSCRIBE_SECRET=
# E-postadaki bağlantılar: sitenin ve API'nin herkese açık adresleri (abonelikten çıkma = PUBLIC_API_URL/email/unsubscribe)
PUBLIC_SITE_URL=
PUBLIC_API_URL=

# --- Script'ler (sadece npm run create-admin / create-users için) -----------
# Admin email adresi
ADMIN_EMAIL=
# Admin kullanıcı adı (3-20 karakter, harf/rakam/alt çizgi)
ADMIN_USERNAME=
# Admin şifresi (en az 12 karakter)
ADMIN_PASSWORD=
# Test kullanıcıları için ortak şifre (boş: rastgele üretilir)
TEST_USER_PASSWORD=

# --- Yerel geliştirme ---------------------------------------------------------
# Şifresiz hızlı giriş yalnızca yerel DB (localhost) + NODE_ENV≠production iken açılır; kapatmak için 0
DEV_LOGIN=

# --- İşlem: ABD hisse seansı (020) -------------------------------------------
# NYSE 09:30–16:00 New York (yaz saati + tatiller) kuralı varsayılan olarak AÇIK. off → hisseler 7/24 işlem görür
# (yalnızca testler / özel demo için; canlıda tanımlamayın). Yerelde saati kaydırmak: PUT /api/market/dev/clock {"now": ISO|null}
US_MARKET_HOURS=

# --- Ölçekleme: worker, iş kilitleri, Redis (bkz. docs/YAYIN_KONTROL_LISTESI.md §4) ---------
# Bu süreçte zamanlanmış işler (cron) çalışsın mı: 1 | 0. Boş → AÇIK (tek süreç). Ayrı worker kullanılıyorsa
# (npm run start:worker) API örneklerinde 0 yapın; worker bu değeri yok sayar.
RUN_JOBS=
# Worker sağlık / metrik portu (varsayılan 5002) ve kapanışta süren işleri bekleme süresi (ms, varsayılan 25000)
WORKER_PORT=
WORKER_SHUTDOWN_GRACE_MS=
# İş kilitleri (PostgreSQL advisory lock) için doğrudan (session modlu) bağlantı adresi. DATABASE_URL bir
# işlem-modlu havuzlayıcıysa (PgBouncer/Supabase "transaction", Neon -pooler) ZORUNLU; boş → DATABASE_URL
JOB_LOCK_DATABASE_URL=
# İsteğe bağlı Redis: redis://[:şifre@]host:6379/0 veya rediss://… Boş → her şey süreç içinde (tek örnek).
# Çoklu API örneği / ayrı worker için gerekli: SSE olay dağıtımı, ortak rate limit sayaçları, admin iş durumları
REDIS_URL=
# Redis anahtar/kanal ön eki (varsayılan portfoygo); aynı Redis'i paylaşan ortamları ayırır
REDIS_PREFIX=
# Süreç içi önbellek süreleri (ms): liderlik + profil sırası (varsayılan 15000), piyasa listesi (varsayılan 5000); 0 → kapalı
LEADERBOARD_CACHE_MS=
MARKET_LIST_CACHE_MS=

# --- Gözlemlenebilirlik ---------------------------------------------------------
# Hata takibi (isteğe bağlı): Sentry DSN. Boş → kapalı (@sentry/node hiç yüklenmez)
SENTRY_DSN=
# Sentry ortam adı (boş: NODE_ENV) ve sürüm (ör. git SHA)
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# Prometheus GET /metrics için Bearer belirteci (en az 32 karakter rastgele). Boş → /metrics 404
METRICS_TOKEN=
