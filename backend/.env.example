# =============================================================================
# PortfoyGo backend — örnek ortam değişkenleri
# Bu dosyayı .env olarak kopyalayıp değerleri doldurun. .env dosyasını ASLA commit etmeyin.
# =============================================================================

# --- Sunucu ------------------------------------------------------------------
# Çalışma ortamı: development | production
NODE_ENV=
# API'nin dinleyeceği port (varsayılan 5001)
PORT=
# İzin verilen frontend origin'leri, virgülle ayrılmış (örn. https://portfoygo.com,http://localhost:3000)
ALLOWED_ORIGINS=
# Reverse proxy (nginx, Render, Railway vb.) arkasındaysa 1 yapın; rate limit gerçek IP'yi görsün
TRUST_PROXY=

# --- Kimlik doğrulama --------------------------------------------------------
# ZORUNLU. JWT imzalama anahtarı; en az 32 karakter, rastgele (örn. `openssl rand -hex 48`)
JWT_SECRET=
# Oturum çerezi (pg_session, httpOnly) için Secure bayrağı: 1 | true. NODE_ENV=production iken her zaman açıktır
COOKIE_SECURE=
# Çerez alan adı (isteğe bağlı). Frontend ve API farklı alt alan adlarındaysa ortak üst alan adı verin
# (örn. app.portfoygo.com + api.portfoygo.com için .portfoygo.com). Boş: sadece API host'u
COOKIE_DOMAIN=

# --- Veritabanı --------------------------------------------------------------
# Tam bağlantı adresi (verilirse DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD yok sayılır)
DATABASE_URL=
# DATABASE_URL yoksa kullanılan ayrı parametreler
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# SSL kullanımı: true | false (boş: DATABASE_URL içindeki sslmode geçerli olur)
DB_SSL=
# SSL sertifika doğrulaması (varsayılan true). Sadece zorunluysa false yapın
DB_SSL_REJECT_UNAUTHORIZED=
# İsteğe bağlı özel CA sertifikası (PEM; satır sonları \n olarak yazılabilir)
DB_SSL_CA=
# Havuzdaki en fazla bağlantı sayısı (varsayılan 10)
DB_POOL_MAX=
# Bağlantı kurma zaman aşımı, ms (varsayılan 10000)
DB_CONNECTION_TIMEOUT_MS=
# Boştaki bağlantının kapatılma süresi, ms (varsayılan 30000)
DB_IDLE_TIMEOUT_MS=

# --- Veri sağlayıcı seçimi (bkz. src/providers/README.md) -------------------
# Boş bırakılırsa varsayılanlar kullanılır: finnhub / coingecko / nosyapi / nosyapi / rss
STOCK_PROVIDER=
CRYPTO_PROVIDER=
FX_PROVIDER=
COMMODITY_PROVIDER=
NEWS_PROVIDER=

# --- Piyasa verisi API anahtarları ------------------------------------------
# Finnhub hisse verisi: tek anahtar
FINNHUB_API_KEY=
# Finnhub: birden çok anahtar, virgülle ayrılmış (verilirse FINNHUB_API_KEY yerine kullanılır)
FINNHUB_API_KEYS=
# Takip edilen hisseler, virgülle ayrılmış (boş: AAPL,MSFT,GOOGL,AMZN,TSLA,META,NVDA,NFLX,AMD,INTC)
STOCK_SYMBOLS=
# CoinGecko anahtarı (isteğe bağlı; boşsa ücretsiz uç kullanılır)
COINGECKO_API_KEY=
# Eski ad (geriye dönük uyumluluk); COINGECKO_API_KEY tercih edin
NEXT_PUBLIC_COINGECKO_API_KEY=
# NosyAPI döviz kurları anahtarı
DOVIZ=
# NosyAPI emtia fiyatları anahtarı
EMTIA=
# Veritabanında güncel USD kuru yoksa kullanılacak yedek USD/TRY (boş/0: işlemler reddedilir)
DEFAULT_USD_TRY=
# Herkese açık hisse listesi isteklerinin arka plan cache yenilemesini kapatmak için false
ENABLE_BACKGROUND_STOCK_REFRESH=

# --- Email (SMTP) ------------------------------------------------------------
# SMTP sunucusu (varsayılan smtp.gmail.com)
SMTP_HOST=
# SMTP portu (varsayılan 587)
SMTP_PORT=
# TLS ile bağlan: true | false (boş: port 465 ise true)
SMTP_SECURE=
# SMTP kullanıcı adı
SMTP_USER=
# SMTP şifresi / uygulama şifresi
SMTP_PASS=
# Gönderen adresi (boş: "PortfoyGo" <SMTP_USER>)
SMTP_FROM=

# --- Script'ler (sadece npm run create-admin / create-users için) -----------
# Admin email adresi
ADMIN_EMAIL=
# Admin kullanıcı adı (3-20 karakter, harf/rakam/alt çizgi)
ADMIN_USERNAME=
# Admin şifresi (en az 12 karakter)
ADMIN_PASSWORD=
# Test kullanıcıları için ortak şifre (boş: rastgele üretilir)
TEST_USER_PASSWORD=
