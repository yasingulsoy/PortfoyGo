{
  "name": "trading-platform-backend",
  "version": "1.0.0",
  "description": "Trading Platform Backend API",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts",
    "kill-port": "powershell -ExecutionPolicy Bypass -File ./kill-port.ps1",
    "dev:clean": "npm run kill-port && npm run dev",
    "create-tables": "ts-node src/scripts/createTables.ts",
    "migrate": "ts-node src/scripts/migrate.ts",
    "create-users": "ts-node src/scripts/createTestUsers.ts",
    "create-user": "ts-node src/scripts/createUser.ts",
    "add-admin-columns": "ts-node src/scripts/addAdminColumns.ts",
    "add-leaderboard-week-columns": "ts-node src/scripts/addLeaderboardWeekColumns.ts",
    "create-admin": "ts-node src/scripts/createAdminUser.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "trading",
    "crypto",
    "stocks",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.16",
    "pg": "^8.11.3",
    "rss-parser": "^3.13.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.10.9",
    "@types/supertest": "^6.0.3",
    "nodemon": "^3.0.2",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^4.1.11"
  }
}
