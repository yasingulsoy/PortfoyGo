# Frontend (Next.js) ortam değişkenleri — bu dosyayı .env.local olarak kopyalayıp doldurun.

# Express backend API adresi (tarayıcıdan erişilir, gizli bilgi koymayın).
# API_PROXY_TARGET kullanılıyorsa /api/backend yapın (aynı origin; oturum çerezi frontend alan adına yazılır)
NEXT_PUBLIC_API_URL=http://localhost:5001/api

# İsteğe bağlı (build sırasında okunur): Next, /api/backend/* isteklerini ${API_PROXY_TARGET}/api/* adresine aktarır.
# Örn. https://api.portfoygo.com — boş: rewrite yok, tarayıcı API'ye doğrudan gider
API_PROXY_TARGET=

# Sunucu tarafı: hisse grafikleri için Finnhub anahtarı (yalnızca /api/asset/history kullanır)
FINNHUB_API_KEY=

# Sunucu tarafı: CoinGecko demo anahtarı (opsiyonel, kripto grafikleri için hız sınırını artırır)
COINGECKO_API_KEY=

# Sitenin genel adresi (Open Graph görselleri için), örn. https://portfoygo.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
