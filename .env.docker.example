# =============================================================================
# docker compose ortam değişkenleri — kopyalayın:  cp .env.docker.example .env.docker
# Kullanım:  docker compose --env-file .env.docker up --build
# Bu dosyada GERÇEK SIR YOKTUR; .env.docker'ı asla commit etmeyin (.gitignore .env* dışlar).
# =============================================================================

# --- PostgreSQL (compose içindeki postgres:16-alpine) -------------------------
POSTGRES_DB=portfoygo
POSTGRES_USER=portfoygo
# DEĞİŞTİRİN: yerel veritabanı şifresi
POSTGRES_PASSWORD=change-me-local-db-password

# --- API ---------------------------------------------------------------------
# DEĞİŞTİRİN! Bu yalnızca bir yer tutucudur. Güçlü, rastgele bir değer üretin:
#   openssl rand -hex 48
JWT_SECRET=REPLACE_ME_with_output_of_openssl_rand_hex_48_________________
# Site + admin origin'leri (virgülle). Gerçek alan adlarında https://... kullanın ve CORS_ALLOW_LOCALHOST=0 yapın
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOW_LOCALHOST=1
# Çerez alan adı: localhost için boş bırakın
COOKIE_DOMAIN=
LOG_LEVEL=info

# --- Tarayıcının gördüğü adresler (web/admin imajlarına BUILD sırasında gömülür) ---
PUBLIC_API_URL=http://localhost:5001/api
PUBLIC_SITE_URL=http://localhost:3000

# --- İsteğe bağlı: piyasa verisi ve e-posta ----------------------------------
# Boşsa piyasa önbelleği dış API'lerden doldurulamaz; DISABLE_MARKET_REFRESH=1 dış çağrıları kapatır
DISABLE_MARKET_REFRESH=
FINNHUB_API_KEY=
COINGECKO_API_KEY=
DOVIZ=
EMTIA=
DEFAULT_USD_TRY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
